<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Why Is It Day In The UK And Night In Japan?</title>

<style>
body{
    margin:0;
    font-family:Arial, sans-serif;
    background:linear-gradient(#00112d,#000814);
    color:white;
    overflow:hidden;
    text-align:center;
}

h1{
    margin-top:10px;
    font-size:2rem;
}

p{
    max-width:800px;
    margin:auto;
}

.controls{
    margin:10px;
}

button{
    padding:10px 18px;
    margin:5px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:1rem;
}

#scene{
    position:relative;
    width:100vw;
    height:80vh;
}

.sun{
    position:absolute;
    width:180px;
    height:180px;
    background:radial-gradient(circle,#fff799,#ffcc00,#ff9900);
    border-radius:50%;
    left:10%;
    top:50%;
    transform:translateY(-50%);
    box-shadow:0 0 80px #ffd700;
}

.orbit{
    position:absolute;
    width:500px;
    height:500px;
    border:2px dashed rgba(255,255,255,0.15);
    border-radius:50%;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
}

.earth-container{
    position:absolute;
    left:50%;
    top:50%;
    transform-origin:center center;
}

.earth{
    width:160px;
    height:160px;
    border-radius:50%;
    position:relative;
    overflow:hidden;
    background:
        linear-gradient(
            90deg,
            #1e3a8a 0%,
            #2e8b57 25%,
            #1e90ff 50%,
            #2e8b57 75%,
            #1e3a8a 100%
        );
    animation:spinEarth 12s linear infinite;
    box-shadow:inset -40px 0 40px rgba(0,0,0,0.5);
}

.axis{
    position:absolute;
    width:4px;
    height:220px;
    background:red;
    left:78px;
    top:-30px;
    transform:rotate(23deg);
}

.marker{
    position:absolute;
    width:12px;
    height:12px;
    border-radius:50%;
}

.uk{
    background:white;
    top:45px;
    left:68px;
}

.japan{
    background:red;
    top:55px;
    left:115px;
}

.label{
    position:absolute;
    font-weight:bold;
    font-size:14px;
    white-space:nowrap;
}

.uklabel{
    top:25px;
    left:20px;
}

.japanlabel{
    top:35px;
    left:120px;
}

.fact{
    margin-top:10px;
    font-size:1.2rem;
    color:#ffe066;
}

@keyframes spinEarth{
    from{
        background-position:0 0;
    }
    to{
        background-position:320px 0;
    }
}
</style>
</head>

<body>

<h1>🌍 Day in the UK, Night in Japan</h1>

<p>
The Earth spins like a toy top. ☀️
When the UK faces the Sun it is daytime there.
At the same time, Japan may be facing away from the Sun, so it is night time!
</p>

<div class="controls">
<button onclick="toggleOrbit()">Orbit Around Sun</button>
<button onclick="toggleSeasons()">Show Seasons Tilt</button>
</div>

<div id="scene">

<div class="sun"></div>

<div class="orbit"></div>

<div id="earthContainer" class="earth-container">

<div id="axis" class="axis"></div>

<div class="earth">
    <div class="marker uk"></div>
    <div class="marker japan"></div>

    <div class="label uklabel">🇬🇧 UK</div>
    <div class="label japanlabel">🇯🇵 Japan</div>
</div>

</div>

</div>

<div class="fact" id="fact">
🌞 The Sun stays still and Earth spins every day.
</div>

<script>

const earthContainer = document.getElementById('earthContainer');
const axis = document.getElementById('axis');
const fact = document.getElementById('fact');

let orbiting = false;
let seasons = false;
let angle = 0;

function animate(){

    if(orbiting){
        angle += 0.004;

        const radius = 250;

        const x = Math.cos(angle) * radius;
        const y = Math.sin(angle) * radius;

        earthContainer.style.left =
            `calc(50% + ${x}px)`;

        earthContainer.style.top =
            `calc(50% + ${y}px)`;
    }

    requestAnimationFrame(animate);
}

animate();

function toggleOrbit(){

    orbiting = !orbiting;

    fact.textContent = orbiting
        ? "🌍 Earth slowly travels around the Sun once every year."
        : "🌞 Earth spins every day. That gives us day and night.";
}

function toggleSeasons(){

    seasons = !seasons;

    axis.style.transform =
        seasons
            ? "rotate(23deg)"
            : "rotate(0deg)";

    fact.textContent = seasons
        ? "🌱 The Earth is tilted. That helps create the seasons."
        : "🌍 Earth is spinning on its axis.";
}
</script>

</body>
</html>
